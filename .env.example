# Runtime
NODE_ENV=development
APP_ENV=local

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Database
DATABASE_URL=postgresql://house_designer:house_designer@localhost:5432/house_designer?schema=public

# Authentication foundation
AUTH_PROVIDER=local
AUTH_SECRET=replace-with-a-local-development-secret

# Upload and storage foundation
LOCAL_STORAGE_ROOT=./local-storage
MAX_UPLOAD_BYTES=52428800
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider foundation
AI_PROVIDER=local
OPENAI_API_KEY=

# Billing provider foundation
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
